# ============================================================
# NullVoid AI — environment configuration
#
# The app runs in two modes:
#   SOLO MODE  — leave the optional keys empty. Auth, realtime and
#                background jobs fall back to local implementations.
#                Only DATABASE_URL and a Gemini key are required.
#   FULL MODE  — configure everything for multiplayer collaboration,
#                real accounts and background AI jobs.
# ============================================================

# --- REQUIRED: PostgreSQL (local, Neon, Supabase, RDS...) ---
DATABASE_URL="postgresql://user:password@localhost:5432/nullvoid"

# --- REQUIRED: Google Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override; defaults to gemini-flash-latest with automatic fallback.
# GEMINI_MODEL=gemini-flash-latest

# --- OPTIONAL: Clerk authentication (https://dashboard.clerk.com) ---
# Without these the app runs as a single local guest user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- OPTIONAL: Liveblocks realtime collaboration (https://liveblocks.io) ---
# Without this the canvas runs in solo mode (local state + DB autosave).
LIVEBLOCKS_SECRET_KEY=

# --- OPTIONAL: Trigger.dev background jobs (https://trigger.dev) ---
# Without this, AI design & spec generation run inline in the API routes.
TRIGGER_SECRET_KEY=

# --- OPTIONAL: Vercel Blob storage (https://vercel.com/docs/storage/vercel-blob) ---
# Without this, canvases and specs are stored inline in PostgreSQL.
BLOB_READ_WRITE_TOKEN=

# --- OPTIONAL: Sentry error monitoring ---
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- OPTIONAL: force auth bypass for local previews (never in production) ---
# PREVIEW_BYPASS_AUTH=true
